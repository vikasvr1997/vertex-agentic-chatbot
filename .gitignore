# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Env files and secrets — never commit real credentials
.env
.env.*
!.env.example
*serviceaccount*.json
*service-account*.json
*-key.json
*credentials*.json
!openapi/*.json
*.pem

# Dev flow-visualizer local state (developer debugging tool, not product data)
dev_data/

# `adk web` local session storage (runtime artifact, not source)
.adk/

# Test / coverage / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Chainlit local state
.chainlit/
.files/

# Streamlit local state
.streamlit/secrets.toml
# Symlink `streamlit run` creates into .venv/.../streamlit/.agents/skills/
/.agents/skills/developing-with-streamlit

# IDE
.idea/
.vscode/
.DS_Store

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
/.ignore
/.mcp.json
/.claude/

# Terraform local state/artifacts — never commit state (can expose resource
# details) or the downloaded provider cache (large, regenerable via
# `terraform init`). The lock file (.terraform.lock.hcl) IS committed.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
