# Copy to .env and fill in values. Never commit the real .env file.
# No Vertex AI API keys here on purpose — this project authenticates to
# Vertex AI exclusively via Application Default Credentials (ADC).
# Run: gcloud auth application-default login
# and: gcloud config set project <your-project-id>

# --- Google Cloud / Vertex AI ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Leave empty until you deploy a Vertex AI Agent Engine (Reasoning Engine).
# Format once deployed: projects/<project>/locations/<location>/reasoningEngines/<id>
VERTEX_AGENT_ENGINE_ID=

# Used only when VERTEX_AGENT_ENGINE_ID is empty, i.e. local development
# against a Gemini model directly (still via ADC, no API key).
VERTEX_MODEL_NAME=gemini-2.5-flash

# --- BigQuery data-query agent (read-only) ---
# Leave empty to skip SQL routing entirely — every message goes to chat.
# The runtime ADC identity needs roles/bigquery.dataViewer on this dataset
# and roles/bigquery.jobUser on the project. Never grant write roles.
BIGQUERY_DEFAULT_DATASET=
BIGQUERY_MAX_ROWS=200
BIGQUERY_QUERY_TIMEOUT_SECONDS=30
BIGQUERY_MAX_BYTES_BILLED=200000000

# --- Internal API (FastAPI backend) ---
# Shared secret between the backend and the Streamlit/Chainlit frontends.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=change-me-local-dev-only
BACKEND_URL=http://localhost:8080

# --- Logging ---
LOG_LEVEL=INFO
ENVIRONMENT=local
